{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "waft",
  "version": "0.1.0",
  "identifier": "dev.waft.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "waft",
        "width": 360,
        "height": 520,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.svg"]
  }
}
